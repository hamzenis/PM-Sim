{
    "schema_version": 1,
    "name": "Monday Natural Products: Data Warehouse Migration",
    "description": "The CFO of Monday Natural Products sponsors the migration from the company's legacy reporting platform to a maintainable data warehouse so leaders can receive faster, consistent information for operational and strategic decisions. Delivery depends on reliable data and subject-matter input from ERP, e-commerce, logistics, and finance teams, and the warehouse must go live within the fixed 14-week window. The client values budget predictability: although the simulation displays a nominal EUR 240,000 budget, management has reserved EUR 30,000 of it as contingency and expects the baseline plan to spend no more than EUR 210,000. Key risks include inconsistent source data, limited stakeholder availability, compressed unit and integration testing, and inadequate knowledge transfer to the support team. You are taking over as project manager and must balance delivery flow, quality, schedule, and transparent cost control.",
    "authored_content": {
        "fragments": [
            {
                "id": "project_briefing",
                "title": "Initial Project Charter",
                "body": "You are taking over as project manager. Deliver a maintainable warehouse integrating ERP, e-commerce, logistics, and finance data by the end of week 14. Protect current operations, establish data ownership, and plan unit, integration, and acceptance testing plus support-team knowledge transfer. The nominal budget is EUR 240,000; management has reserved EUR 30,000 for contingency, so plan to a EUR 210,000 baseline ceiling.",
                "required": true
            },
            {
                "id": "delivery_constraints",
                "title": "Week 4 Sponsor Update",
                "body": "A new supplier-data compliance requirement needs traceable transformations and extra validation. At the same time, supplier costs have risen. The sponsor therefore imposes a new EUR 190,000 spending ceiling for the remainder of the project. This is a management constraint, not a change to the simulation's displayed EUR 240,000 nominal budget. Reforecast, protect the fixed go-live, and escalate trade-offs.",
                "required": true
            },
            {
                "id": "quality_readiness_briefing",
                "title": "Quality and Readiness Briefing",
                "body": "Before go-live, review rejected transformations, unresolved source-data issues, and coverage across ERP, e-commerce, logistics, and finance interfaces. Confirm stakeholder availability for acceptance decisions, preserve enough capacity for integration and regression testing, and schedule documented knowledge-transfer sessions. Recommend corrective action without treating unfinished or untested work as delivered value.",
                "required": true
            },
            {
                "id": "handover_briefing",
                "title": "Steering-Committee Review",
                "body": "Present the terminal review to the steering committee. Compare accepted scope, defects, elapsed time, and total cost with the fixed go-live and management's EUR 190,000 spending ceiling, while also reporting the engine's unchanged EUR 240,000 nominal budget. Explain your major trade-off, residual data and operational risks, test evidence, stakeholder acceptance, and whether the support team can operate the warehouse.",
                "required": true
            }
        ],
        "questions": [
            {
                "id": "initial_strategy",
                "prompt": "Which principle will guide your initial delivery strategy?",
                "answer_schema": "single_choice",
                "options": [
                    {
                        "id": "balanced_control",
                        "label": "Balance budget, progress, and continuous testing"
                    },
                    {
                        "id": "budget_first",
                        "label": "Minimize staffing cost before optimizing delivery"
                    },
                    {
                        "id": "speed_first",
                        "label": "Maximize early development throughput"
                    },
                    {
                        "id": "quality_first",
                        "label": "Prioritize testing and defect prevention"
                    }
                ],
                "feedback_by_option": {
                    "balanced_control": "Track all three constraints weekly and adjust before a gap becomes expensive.",
                    "budget_first": "A small team protects budget but may create deadline pressure and late testing risk.",
                    "speed_first": "Fast development only creates value when completed work also passes testing and integration.",
                    "quality_first": "Strong quality controls support handover, but the team must still maintain delivery flow."
                }
            },
            {
                "id": "migration_risks",
                "prompt": "Which risks need active control during the migration?",
                "answer_schema": "multiple_choice",
                "options": [
                    {
                        "id": "data_quality",
                        "label": "Source-data quality and transformation defects"
                    },
                    {
                        "id": "source_changes",
                        "label": "Changes to connected source systems"
                    },
                    {
                        "id": "performance",
                        "label": "Reporting and processing performance"
                    },
                    {
                        "id": "knowledge_transfer",
                        "label": "Maintainability and client knowledge transfer"
                    }
                ]
            },
            {
                "id": "test_readiness",
                "prompt": "Is the remaining plan sufficient to complete integration testing within the budget and deadline?",
                "answer_schema": "boolean"
            },
            {
                "id": "final_retrospective",
                "prompt": "Summarize the most important trade-off you made and how it affected the migration outcome.",
                "answer_schema": "short_text",
                "short_text_max_length": 500
            }
        ],
        "events": [
            {
                "id": "handover_ready",
                "effects": [
                    {
                        "type": "set_presentation_flag",
                        "payload": {
                            "flag": "handover_review_ready",
                            "value": true
                        }
                    }
                ]
            }
        ],
        "sequence": [
