{
    "schema_version": 1,
    "name": "Datawarehouse Migration KT 1571220",
    "description": "Monday Natural Products GmbH & Co. KG is a long-established producer and distributor of high-quality dietary supplements, recognized for innovative products and strong industry partnerships. The company is investing in a new Data Warehouse System to accelerate data processing, automate data preparation, improve reporting, and support strategic decision-making. The delivered platform must provide a maintainable, high-quality foundation for the client's future IT landscape and must include sufficient testing. Budget compliance is the client's highest priority because it demonstrates financial reliability and supports a long-term partnership. The implementation is also time-sensitive: connected systems cannot move forward until the Data Warehouse is available, although current business operations remain supported by the existing solution during the project.",
    "authored_content": {
        "fragments": [
            {
                "id": "project_briefing",
                "title": "Project Briefing",
                "body": "Build and migrate to a maintainable Data Warehouse for Monday Natural Products. The platform must automate data preparation, improve processing and reporting, and support management decisions without compromising the client's currently stable operations.",
                "required": true
            },
            {
                "id": "delivery_constraints",
                "title": "Delivery Constraints",
                "body": "Budget compliance has the highest client priority. Delivery speed matters because downstream IT work depends on the new platform, while sufficient unit and integration testing is required for a dependable handover.",
                "required": true
            },
            {
                "id": "handover_briefing",
                "title": "Handover Review",
                "body": "Review the accepted workload, remaining defects, elapsed time, and total cost. Consider whether the delivered platform gives the client a reliable basis for operating and extending its IT landscape.",
                "required": true
            }
        ],
        "questions": [
            {
                "id": "initial_strategy",
                "prompt": "Which principle will guide your initial delivery strategy?",
                "answer_schema": "single_choice",
                "options": [
                    {
                        "id": "balanced_control",
                        "label": "Balance budget, progress, and continuous testing"
                    },
                    {
                        "id": "budget_first",
                        "label": "Minimize staffing cost before optimizing delivery"
                    },
                    {
                        "id": "speed_first",
                        "label": "Maximize early development throughput"
                    },
                    {
                        "id": "quality_first",
                        "label": "Prioritize testing and defect prevention"
                    }
                ],
                "feedback_by_option": {
                    "balanced_control": "Track all three constraints weekly and adjust before a gap becomes expensive.",
                    "budget_first": "A small team protects budget but may create deadline pressure and late testing risk.",
                    "speed_first": "Fast development only creates value when completed work also passes testing and integration.",
                    "quality_first": "Strong quality controls support handover, but the team must still maintain delivery flow."
                }
            },
            {
                "id": "migration_risks",
                "prompt": "Which risks need active control during the migration?",
                "answer_schema": "multiple_choice",
                "options": [
                    {
                        "id": "data_quality",
                        "label": "Source-data quality and transformation defects"
                    },
                    {
                        "id": "source_changes",
                        "label": "Changes to connected source systems"
                    },
                    {
                        "id": "performance",
                        "label": "Reporting and processing performance"
                    },
                    {
                        "id": "knowledge_transfer",
                        "label": "Maintainability and client knowledge transfer"
                    }
                ]
            },
            {
                "id": "test_readiness",
                "prompt": "Is the remaining plan sufficient to complete integration testing within the budget and deadline?",
                "answer_schema": "boolean"
            },
            {
                "id": "final_retrospective",
                "prompt": "Summarize the most important trade-off you made and how it affected the migration outcome.",
                "answer_schema": "short_text",
                "short_text_max_length": 500
            }
        ],
        "events": [
